# Пример переменных окружения для локального запуска оператора.
# Скопируйте в .env, подставьте свои значения и загрузите в оболочку:
#   set -a; source .env; set +a
#   make run

# --- Nexus (обязательные) ---
NEXUS_URL=https://nexus.kostoed.ru
NEXUS_USER=admin
NEXUS_PASSWORD=changeme

# --- Режим работы ---
# reconcile — обычная работа контроллеров, import — выгрузка существующих ресурсов в CR
OPERATOR_MODE=reconcile
# namespace для watch в reconcile-режиме (по умолчанию namespace пода)
WATCH_NAMESPACE=nexus
# namespace для создания CR в import-режиме (пусто — все namespace)
IMPORT_NAMESPACE=
# удалять репозитории из Nexus при удалении CR
ENABLE_REPOSITORY_DELETION=false
# список контроллеров через запятую (пусто — все, кроме отключённых)
ENABLED_CONTROLLERS=
# включить validating webhooks
ENABLE_WEBHOOKS=false
# путь к файловому конфигу (по умолчанию /config/config.yaml)
APP_CONFIG_PATH=

# --- External Secrets (опционально) ---
# если ESO_SECRET_STORE и ESO_VAULT_PATH заданы, оператор создаёт ExternalSecret для proxy-auth
ESO_SECRET_STORE=
ESO_VAULT_PATH=
ESO_PROXY_AUTH_SECRET=nexus-proxy-auth
ESO_REFRESH_INTERVAL=1h

# --- Keycloak (опционально, без них KeycloakRoleSync не запускается) ---
KEYCLOAK_URL=https://auth.kostoed.ru/auth
KEYCLOAK_REALM=cicd
KEYCLOAK_CLIENT_ID=nexus-operator
KEYCLOAK_CLIENT_SECRET=changeme
KEYCLOAK_NEXUS_CLIENT=nexus
# realm для получения токена, если отличается от KEYCLOAK_REALM
KEYCLOAK_AUTH_REALM=
